#!/usr/bin/env bash
# apk-pipeline configuration
# Source this file: source config.env

# ── Output ──────────────────────────────────────────────
export PIPELINE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export OUTPUT_BASE="${PIPELINE_DIR}/output"

# ── Tool paths (auto-detect, override if needed) ────────
export JADX=$(command -v jadx 2>/dev/null)
export APKTOOL=$(command -v apktool 2>/dev/null)
export ADB=$(command -v adb 2>/dev/null)
export AAPT=$(command -v aapt 2>/dev/null)
export APK2URL=$(command -v apk2url 2>/dev/null)
export R2=$(command -v r2 2>/dev/null || command -v radare2 2>/dev/null)
export FRIDA=$(command -v frida 2>/dev/null)
export YARA=$(command -v yara 2>/dev/null)
export SSDEEP=$(command -v ssdeep 2>/dev/null)
export EXIFTOOL=$(command -v exiftool 2>/dev/null)
export D2J_DEX2JAR=$(command -v d2j-dex2jar 2>/dev/null)
export APKSIGNER=$(command -v apksigner 2>/dev/null)
export ZIPALIGN=$(command -v zipalign 2>/dev/null)

# ── Analysis options ────────────────────────────────────
export DECOMPILE_SOURCES=true
export DECOMPILE_RESOURCES=true
export EXTRACT_NATIVE_LIBS=true
export EXTRACT_URLS=true
export EXTRACT_SECRETS=true
export RUN_FRIDA=false
export FRIDA_SCRIPT=""

# apk2url mode:
#   fast   = reuse our jadx+apktool output (same extraction logic, instant)
#   binary = run the apk2url tool itself (re-decompiles, slower, more thorough)
export APK2URL_MODE="fast"
export APK2URL_TIMEOUT="300"

# ── ASC (Droid ASC — fast cross-DEX ref search / targeted decompile) ──
# Droid ASC by MG193.7 (@MG1937) — https://github.com/MG1937/ASC
# Set ASC_DIR explicitly to override auto-detection (~/ASC, ./ASC, /opt/ASC).
export ASC_DIR="${ASC_DIR:-}"

find_asc() {
    if [ -n "$ASC_DIR" ] && [ -f "$ASC_DIR/main.py" ]; then
        printf '%s' "$ASC_DIR/main.py"
        return 0
    fi
    for _asc_cand in "${HOME}/ASC" "${PIPELINE_DIR}/ASC" "/opt/ASC"; do
        if [ -f "$_asc_cand/main.py" ]; then
            printf '%s' "$_asc_cand/main.py"
            return 0
        fi
    done
    return 1
}

export ASC_MAIN="$(find_asc 2>/dev/null || true)"

# ── Report ──────────────────────────────────────────────
export REPORT_FORMAT="markdown"
